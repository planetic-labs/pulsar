FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Установка системных зависимостей
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgomp1 \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Установка uv (рекомендованный способ Astral)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Настройка виртуального окружения в PATH
ENV PATH="/app/.venv/bin:$PATH"

# Аргументы для UID/GID для совместимости прав на файлы
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd -g ${GROUP_ID} appuser || true && \
    useradd -l -u ${USER_ID} -g ${GROUP_ID} -m appuser || true

# Подготовка директорий
RUN mkdir -p /app/downloads /app/data /app/storage && \
    chown -R ${USER_ID}:${GROUP_ID} /app

USER appuser

# Копируем файлы зависимостей
COPY pyproject.toml uv.lock README.md ./

# Установка зависимостей (без dev-пакетов)
RUN uv sync --frozen --no-dev

# Копируем исходный код и ресурсы
COPY app ./app
COPY scripts ./scripts
COPY cron ./cron
COPY templates ./templates
COPY static ./static

# Пробрасываем порт
EXPOSE 8350

# Запуск приложения
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8350"]

