FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /srv/search-ui

# Установка системных зависимостей
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgomp1 \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Установка uv
RUN pip install --no-cache-dir uv

# Аргументы для UID/GID для совместимости прав на файлы
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd -g ${GROUP_ID} appuser || true && \
    useradd -l -u ${USER_ID} -g ${GROUP_ID} -m appuser || true

# Подготовка директорий
RUN mkdir -p /srv/search-ui/downloads /srv/search-ui/data /srv/search-ui/storage /srv/search-ui/models_cache && \
    chown -R ${USER_ID}:${GROUP_ID} /srv/search-ui

USER appuser

# Копируем файлы зависимостей
COPY pyproject.toml uv.lock README.md ./

# Установка зависимостей (без dev-пакетов)
RUN uv sync --frozen --no-dev

# Копируем исходный код и ресурсы
COPY app ./app
COPY scripts ./scripts
COPY templates ./templates
COPY static ./static

# Пробрасываем порт
EXPOSE 8000

# Запуск приложения
CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
