# VideoDB - Environment Configuration Example
# Copy this file to .env and fill in the values.

# --- App Security & Settings ---
# Access token for UI and API authentication
APP_ACCESS_TOKEN=change-me-to-something-secure
# Secret key for session encryption
SESSION_SECRET_KEY=generate-a-long-random-string-here

# Application directories (absolute paths recommended for Docker)
APP_STORAGE_DIR=/srv/search-ui/storage
APP_DATA_DIR=/srv/search-ui/data
DISK_SPACE_BUFFER_GB=3

# GitHub Integration (optional, for feedback form)
GITHUB_PAT=
GITHUB_REPO=your-username/your-repo-name

# --- SQLite Settings ---
SQLITE_DB_PATH=/srv/search-ui/data/search_ui.db

# --- Qdrant Settings ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks_m3

# --- S3 Backup Settings (optional) ---
S3_ENDPOINT_URL=https://s3.your-provider.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=ru-1

# --- Deepgram Settings (Speech-to-Text) ---
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_PROJECT_ID=your-project-id
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru

# --- Google Drive API (Service Account) ---
# Path to your service account JSON key file
GOOGLE_DRIVE_CREDENTIALS_PATH=/srv/search-ui/config/service-key.json
GOOGLE_DRIVE_DOWNLOAD_DIR=/srv/search-ui/downloads
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# --- Embedding Service (Remote Infinity/vLLM) ---
# URL to your Infinity embedding service
EMBEDDING_API_URL=http://infinity:7997/v1
EMBEDDING_API_TOKEN=your-embedding-api-token
EMBEDDING_CACHE_LRU_SIZE=20

# --- Optional Settings ---
# Hugging Face token (if needed for models)
HF_TOKEN=
