# ==============================================================================
# PULSAR SYSTEM CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM SETTINGS (Основные настройки системы)
# ------------------------------------------------------------------------------
# Рабочие директории приложения (рекомендуются абсолютные пути для Docker)
APP_STORAGE_DIR=/app/storage
APP_DATA_DIR=/app/data

# Исключение файлов и папок по ключевым словам (через запятую)
EXCLUDE_KEYWORDS=ГАЛЕРЕЯ,Gallery

# Лимит количества результатов поиска в интерфейсе
APP_RESULTS_LIMIT=50

# Порт для запуска FastAPI приложения
APP_PORT=8350

# Минимальный буфер свободного места на диске в ГБ перед остановкой воркера
DISK_SPACE_BUFFER_GB=3

# Порог паузы при нарезке видео на чанки (в секундах)
CHUNKING_PAUSE_THRESHOLD=5.0

# Основной файл Docker Compose конфигурации
COMPOSE_FILE=docker-compose.yml

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (Безопасность и авторизация)
# ------------------------------------------------------------------------------
# Мастер-токен для доступа к UI и API
APP_ACCESS_TOKEN=change-me-to-something-secure-must-be-at-least-32-characters-long

# Секретный ключ для шифрования веб-сессий
SESSION_SECRET_KEY=change-me-to-something-secret-must-be-at-least-32-characters-long

# Роль, дающая доступ к административным функциям при авторизации через Ark
ADMIN_ROLE_NAME=admin

# Роль, дающая доступ к модерации и редактированию субтитров при авторизации через Ark
SUBEDITOR_ROLE_NAME=subeditor

# Время блокировки (резервации) чанка на модерации в секундах (по умолчанию 3 часа)
SUBTITLE_LOCK_TIMEOUT_SEC=10800

# ------------------------------------------------------------------------------
# 3. DATABASE SETTINGS (Настройки СУБД SQLite)
# ------------------------------------------------------------------------------
# Путь к файлу базы данных SQLite
SQLITE_DB_PATH=/app/data/pulsar.db

# ------------------------------------------------------------------------------
# 4. SEARCH ENGINE (Настройки Manticore Search)
# ------------------------------------------------------------------------------
# URL-адрес сервера Manticore Search
MANTICORE_URL=http://manticore:9308

# Название основной таблицы (индекса) в Manticore
MANTICORE_TABLE=chunks

# ------------------------------------------------------------------------------
# 5. EMBEDDING SERVICE (Векторизация текстов через OpenRouter/Infinity/vLLM)
# ------------------------------------------------------------------------------
# Провайдер эмбеддингов: 'custom' (Infinity/vLLM) или 'openai' (OpenRouter/OpenAI)
EMBEDDING_PROVIDER=custom

# URL-адрес API сервиса эмбеддингов
EMBEDDING_API_URL=http://infinity:7997/v1

# API-токен для авторизации в сервисе
EMBEDDING_API_TOKEN=your-embedding-api-token

# Идентификатор используемой модели эмбеддингов
EMBEDDING_MODEL_ID=BAAI/bge-m3

# Размерность векторного пространства модели
EMBEDDING_DIMENSION=1024

# Максимальный размер LRU-кэша для векторов
EMBEDDING_CACHE_LRU_SIZE=20

# Принудительная маршрутизация для OpenRouter (через запятую)
EMBEDDING_OPENROUTER_PROVIDERS=

# Токен Hugging Face (если требуется локальная загрузка моделей)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 6. SPEECH-TO-TEXT (Распознавание речи через Deepgram)
# ------------------------------------------------------------------------------
# API ключ для доступа к Deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key

# ID проекта в личном кабинете Deepgram
DEEPGRAM_PROJECT_ID=your-project-id

# Используемая модель транскрибации
DEEPGRAM_MODEL=nova-3

# Язык распознавания речи по умолчанию
DEEPGRAM_LANGUAGE=ru

# ------------------------------------------------------------------------------
# 7. GOOGLE DRIVE INTEGRATION (Импорт видео из Google Drive)
# ------------------------------------------------------------------------------
# Путь к JSON-файлу с ключами Сервисного Аккаунта Google Cloud
GOOGLE_DRIVE_CREDENTIALS_PATH=/app/config/service-key.json

# Локальная директория для временного скачивания файлов с диска
GOOGLE_DRIVE_DOWNLOAD_DIR=/app/downloads

# Запрашиваемые права доступа (scopes) для Google Drive API
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# ------------------------------------------------------------------------------
# 8. S3 STORAGE SETTINGS (Настройки S3 хранилища)
# ------------------------------------------------------------------------------
# Endpoint-адрес S3 хранилища
S3_ENDPOINT_URL=https://s3.your-provider.com

# Ключи доступа S3
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Имя бакета для хранения бэкапов
S3_BUCKET_NAME=

# Регион S3
S3_REGION_NAME=ru-1


# ------------------------------------------------------------------------------
# 9. RESTIC BACKUP SETTINGS (Инкрементальные бэкапы через Restic)
# ------------------------------------------------------------------------------
# URI репозитория Restic в S3 (или локальный путь)
RESTIC_REPOSITORY=s3:https://s3.your-provider.com/your-bucket

# Пароль для шифрования репозитория Restic
RESTIC_PASSWORD=your-secure-restic-password

# Настройки ротации снимков (количество хранимых копий)
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12

# ------------------------------------------------------------------------------
# 10. TELEGRAM NOTIFICATIONS (Уведомления в Telegram)
# ------------------------------------------------------------------------------
# Токен бота Telegram бота и ID чата для уведомлений о статусе задач
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 11. OTHER INTEGRATIONS (Прочие сторонние интеграции)
# ------------------------------------------------------------------------------
# URL эндпоинта JWKS для авторизации через Ark Messenger
ARK_JWKS_URL=https://api.yourdomain.com/.well-known/jwks.json

# Секрет HMAC-SHA256 для проверки входящих вебхуков Ark
ARK_WEBHOOK_SECRET=my-very-secure-secret-key-1

# Audience и Issuer для валидации JWT токенов
ARK_AUDIENCE=pulsar
ARK_ISSUER=ark-api