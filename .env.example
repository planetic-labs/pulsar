# Database (Postgres with pgvector)
POSTGRES_URL=postgresql://devman:password@db:5432/search_ui

# Transcription Selection: "deepgram", "local", "yandex"
TRANSCRIPTION_ENGINE=deepgram

# Local AI Models (Offline)
# Hugging Face token for faster model downloads (optional)
HF_TOKEN=

# Model for embeddings (e.g., intfloat/multilingual-e5-small)
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
LOCAL_EMBEDDING_DIMENSION=384

# Local ASR (Whisper)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu

# Previous settings (remains for compatibility if you switch engines)
GOOGLE_DRIVE_CREDENTIALS_PATH=/srv/search-ui/google.json
...
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
...
