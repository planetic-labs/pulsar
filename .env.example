# App Security & Settings
APP_ACCESS_TOKEN=Master
SESSION_SECRET_KEY=generate-a-long-random-string-here
APP_STORAGE_DIR=/srv/search-ui/storage
APP_DATA_DIR=/srv/search-ui/data

# SQLite Settings
SQLITE_DB_PATH=/srv/search-ui/data/search_ui.db

# Qdrant Settings
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chunks_m3

# S3 Backup Settings
S3_ENDPOINT_URL=https://s3.selcdn.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=ru-1

# Deepgram Settings (ASR)
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru

# Google Drive API
GOOGLE_DRIVE_CREDENTIALS_PATH=/srv/search-ui/google.json
GOOGLE_DRIVE_TOKEN_PATH=/srv/search-ui/token.json
GOOGLE_DRIVE_DOWNLOAD_DIR=/srv/search-ui/downloads
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Embedding Service (Remote Infinity/vLLM)
EMBEDDING_API_URL=http://infinity:7997/v1
EMBEDDING_API_TOKEN=

# Hugging Face token (optional)
HF_TOKEN=
