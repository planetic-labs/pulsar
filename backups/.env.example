# Configuration for Pulsar Backup Tool
# Copy this to .env and fill in your details

# --- Application Paths ---
# By default, the tool assumes it is located in a subfolder of the project root.
# If you move the tool elsewhere, specify absolute paths here:
# PROJECT_ROOT=/path/to/pulsar
# DATA_DIR=/path/to/pulsar/data
# STORAGE_DIR=/path/to/pulsar/storage
# BACKUP_DIR=/path/to/backups

# --- Qdrant Settings ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=chunks_m3

# --- Docker Settings ---
# If your compose file is not docker-compose.yml (e.g. on production)
# COMPOSE_FILE=docker-compose.prod.yml

# --- Retention Policy ---
MAX_BACKUPS=10
S3_ENDPOINT_URL=https://s3.cloud.ru
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_REGION_NAME=ru-central-1
